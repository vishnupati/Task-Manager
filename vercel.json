{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "buildCommand": "npm run build",
    "installCommand": "npm ci",
    "framework": null,
    "outputDirectory": "dist/task-manager/browser",
    "rewrites": [
        {
            "source": "/((?!.*\\.[\\w]+$).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*\\.js|.*\\.css|.*\\.woff2?|.*\\.ttf|.*\\.eot|.*\\.ico|.*\\.png|.*\\.svg)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}